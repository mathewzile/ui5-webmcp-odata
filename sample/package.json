            },
            "bob": {
              "password": "bob",
              "roles": [
                "Viewer"
              ]
            }
          }
        }
      },
      "[production]": {
        "auth": "xsuaa"
      },
      "destinations": true,
      "html5-repo": true,
      "workzone": true
    }
  }
